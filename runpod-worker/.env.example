# RunPod Serverless worker (ComfyUI + Wan 2.2) — environment variables.
# Set these as the endpoint's Environment Variables in the RunPod console
# (Serverless -> your endpoint -> Edit -> Environment Variables), or pass
# them with --env-file to scripts/deploy_runpod.sh / `docker run`.
# Never commit a filled-in copy of this file.

# --- Cloudinary (required) — same account the Next.js app uses --------
# So videos land in the same Cloudinary account src/lib/cloudinary/* reads
# from, and video_url the frontend stores is a real, browsable URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- ComfyUI / model layout (optional — sane defaults baked in) -------
COMFYUI_DIR=/workspace/ComfyUI
COMFYUI_PORT=8188
MODEL_DIR=/workspace/ComfyUI/models

# --- Model source (optional overrides) ---------------------------------
WAN22_NODE_REPO=https://github.com/kijai/ComfyUI-WanVideoWrapper.git
WAN22_MODEL_REPO=Wan-AI/Wan2.2-I2V-A14B
# Only needed if WAN22_MODEL_REPO is a gated/private Hugging Face repo.
HF_TOKEN=

# --- Build strategy (optional) ------------------------------------------
# true (default): bake Wan 2.2 weights into the Docker image at build
# time — simplest, fully self-contained, larger image / slower builds.
# false: skip at build, download at container boot instead — pair this
# with a RunPod Network Volume mounted at MODEL_DIR so weights persist
# across cold starts instead of re-downloading every time.
BAKE_MODELS=true

# --- Workflow node IDs (optional — only if you swap the workflow) ------
WORKFLOW_PATH=/workspace/workflow/wan22_i2v_template.json
WORKFLOW_IMAGE_NODE_ID=3
WORKFLOW_PROMPT_NODE_ID=6
WORKFLOW_SIZE_NODE_ID=27
WORKFLOW_VIDEO_NODE_ID=41

# --- ComfyUI job polling (optional) -------------------------------------
COMFYUI_POLL_INTERVAL=3
COMFYUI_POLL_TIMEOUT=900

# --- RunPod deploy script (used only by scripts/deploy_runpod.sh) ------
RUNPOD_API_KEY=
DOCKER_IMAGE=
RUNPOD_GPU_TYPE=NVIDIA RTX A5000
RUNPOD_ENDPOINT_NAME=offer-for-you-wan22
