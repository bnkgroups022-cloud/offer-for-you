      "vae": ["39", 0],
      "start_image": ["3", 0]
    }
  },
  "31": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 6.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["37", 0],
      "positive": ["27", 0],
      "negative": ["27", 1],
      "latent_image": ["27", 2]
    }
  },
  "37": {
    "class_type": "UNETLoader",
    "inputs": {
